# ------------------------------------------------------------- trap #0 names
T0 00 sys_puts          ; print NUL-terminated string at (a6) to the current window
T0 01 sys_putc          ; print character d6
T0 02 sys_gotoxy        ; cursor in current window: d6 = row<<8 | column
T0 03 sys_printf        ; format string (a6, or inline if d6 bit0) with %d %t %s ...; d6 bit1 -> to buffer
T0 04 sys_txwait        ; wait until console transmitter idle
T0 05 sys_skipsp        ; skip blanks at (a2)
T0 06 sys_getnum        ; parse number at (a2) -> d1 (d6 = 0 decimal)
T0 07 sys_strcmp        ; compare command word (a2) with table name (a1), case-folded, '.' wildcard
T0 08 sys_malloc        ; allocate d6 bytes (zeroed, 4-byte granules) -> a6
T0 09 sys_free          ; free block a6
T0 0A sys_invalid       ; unused slot (points at the table)
T0 0B sys_putinline     ; print the NUL-terminated string that follows the trap
T0 0C sys_strdup        ; copy string (a6) into a new heap block
T0 0D sys_heapcheck     ; walk the free list (sanity check)
T0 0E sys_freelist      ; free a linked list of blocks starting at (a6)
T0 0F sys_txenable_a    ; start transmitter interrupt, channel A
T0 10 sys_putnum        ; print number d1; d6 = width<<8 | flags (bit0 zero pad, bit1 ..)
T0 11 sys_putaddr       ; print I/O address word (a2 -> buffer)
T0 12 sys_scanner_alloc ; allocate console scan buffer ($69A)
T0 13 sys_scanner_setup ; program the console scanner
T0 14 sys_scanner_free  ; release the scan buffer
T0 15 sys_puthms        ; print d1 ms as h:mm:ss
T0 16 sys_command       ; parse and execute a command line (a6) against cmd_table
T0 17 sys_getword       ; read an identifier at (a2)
T0 18 sys_beep          ; terminal bell (if enabled) and flag screen redraw
T0 19 sys_putmbp        ; print d1 pulses as measure:beat:pulse (d2 = beats per measure)
T0 1A sys_1A
T0 1B sys_readline      ; read a command line into cmdline buffer ($8EC)
T0 1C sys_menu          ; draw the Idle/Run status screen
T0 1D sys_parseio       ; parse console I/O address "AA-A1" -> word at (a1)+
T0 1E sys_fmtio         ; format I/O address word (a1)+ as text
T0 1F sys_alloc_array   ; allocate d6+1 longs, first = count
T0 20 sys_diskerr       ; print the disk error message for code (a3)
T0 21 sys_openwin       ; open text window, a6 -> {?, ?, row, col, height, width, border, ...} -> a6 handle
T0 22 sys_closewin      ; close window a6
T0 23 sys_redrawall     ; redraw every window
T0 24 sys_editline      ; line editor into buffer (a6); N set if ESC
T0 25 sys_selwin        ; make window a6 current for this task
T0 26 sys_curwin        ; a6 -> current window + $10
T0 27 sys_waitkey       ; yield until a key is available
T0 28 sys_indicator     ; console indicator / status flag d6: +n on, -n off
T0 29 sys_yield         ; run the next ready task
T0 2A sys_sleep         ; mark this task not ready and yield
T0 2B sys_wake          ; mark task a6 ready
T0 2C sys_yield_if_long ; yield if this task has run >= 10 ticks
T0 2D sys_listlen       ; count a linked list
T0 2E sys_listhead      ; head of list d6
T0 2F sys_listnth       ; n-th element of list
T0 30 sys_listappend    ; append node
T0 31 sys_listfree      ; free a whole list
T0 32 sys_wpcheck       ; (a3) = 7 "write protected" if the disk is protected
T0 33 sys_crc16         ; CRC-16 over d6 bytes at (a6), table crc_table
T0 34 sys_invalid2      ; unused slot
T0 35 sys_message       ; status message: d6 bit0 inline string, bit1 "--- ", bit2 "*** "
T0 36 sys_findcmd       ; look up command word (a2) in table (a6); d7 = -1 if none
T0 37 sys_getkey        ; next console key -> d1; N set if none
T0 38 sys_txenable_b    ; start transmitter interrupt, channel B
T0 39 sys_newnode       ; allocate list node of d6 bytes
T0 3A sys_freenode      ; free list node
T0 3B sys_pcopen        ; open a PC-link channel (PC disk)
T0 3C sys_pcrequest     ; queue a PC-link request
T0 3D sys_pcqueue       ; add node a6 to the PC-link queue

# ------------------------------------------------------------- trap #1 names
T1 00 dsk_submit        ; hand request a3 with command d6 to the FIL task and wait
T1 01 dsk_mount         ; read boot block, count free sectors (cmd 1)
T1 02 dsk_unmount       ; flush directory, release (cmd 2)
T1 03 dsk_readsec       ; read sector $C(a3) into $E(a3) (cmd 3)
T1 04 dsk_writesec      ; write sector (cmd 4)
T1 05 dsk_format_track  ; format track d0, side from $2(a3)
T1 06 dsk_parsefile     ; parse 'A4"name"' at (a2) -> $2F letter, $2E number, $14 name
T1 07 dsk_open          ; look up slot, $30 = header sector
T1 08 dsk_printname     ; print slot and "name"
T1 09 dsk_create        ; create file in slot (asks R/N/ESC if it exists) (cmd 7)
T1 0A dsk_writehdr      ; write the header sector back (cmd 8)
T1 0B dsk_delete        ; delete file: free header + extents, drop directory entry (cmd 9)
T1 0C dsk_readhdr       ; read header sector, compute size (cmd 12)
T1 0D dsk_findslot      ; find slot word $2E(a3) in the directory -> a1 entry; 4 = not found
T1 0E dsk_addentry      ; insert directory entry (number, letter, header sector) at a1
T1 0F dsk_delentry      ; remove directory entry at a1
T1 10 dsk_getbyte       ; sequential read: next byte of the open file -> d1
T1 11 dsk_getword       ; two bytes, first is the high byte
T1 12 dsk_12
T1 13 dsk_getblock      ; read counted block into a new heap block -> a4
T1 14 dsk_putbyte       ; sequential write of d1
T1 15 dsk_putword       ; write word d1 high byte first
T1 16 dsk_putstr        ; write string (a2)
T1 17 dsk_putblock      ; write counted block from (a4)
T1 18 dsk_nextblock     ; read the next 1 KB block of the open file (cmd 10)
T1 19 dsk_flushblock    ; write current block, allocate the next sector (cmd 11)
T1 1A dsk_parselist     ; parse "A1,A3,..." list and check the slot is in it
T1 1B dsk_printslot     ; print slot letter+number

